# Ma'lumotlar bazasi. Lokal ishlatish uchun SQLite:
# Postgres'ga o'tish: "postgresql://user:parol@host:5432/uyjoy?schema=public"
DATABASE_URL="file:./dev.db"

# Admin panel paroli (ishga tushirishdan oldin o'zgartiring!)
ADMIN_PASSWORD="ozgartiring"

# Sessiya cookie imzosi uchun tasodifiy satr (32+ belgi)
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="tasodifiy-uzun-satr"

# Saytning to'liq manzili (sitemap, OG rasmlari uchun)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
