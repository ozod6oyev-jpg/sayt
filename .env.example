# Ma'lumotlar bazasi. Lokal ishlatish uchun SQLite:
# Postgres'ga o'tish: "postgresql://user:parol@host:5432/uyjoy?schema=public"
DATABASE_URL="file:./dev.db"

# Birinchi sozlash kaliti (owner yaratilgach ishlatilmaydi)
ADMIN_PASSWORD="ozgartiring"

# Sessiya cookie imzosi uchun tasodifiy satr (32+ belgi)
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="tasodifiy-uzun-satr"

# Saytning to'liq manzili (sitemap, OG rasmlari uchun)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Meta bo'limi: Telegram kanalga post joylash va webhook (BotFather tokeni)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
# Webhook imzosini tekshirish uchun tasodifiy satr
TELEGRAM_WEBHOOK_SECRET=""

# Meta (Facebook/Instagram) — App ID, App Secret va Page token panelda kiritiladi.
# Tokenlarni shifrlash kaliti (64 ta hex belgi). Bo'sh bo'lsa SESSION_SECRET dan olinadi.
META_ENCRYPTION_KEY=""

# Saytning tashqi manzili — OAuth qaytish (redirect) havolalari shundan yasaladi.
# Bo'sh bo'lsa NEXT_PUBLIC_SITE_URL ishlatiladi.
META_PUBLIC_BASE_URL=""

# Rejalashtirilgan postlarni joylash endpointini himoyalash uchun sir
CRON_SECRET=""

# Webhook manzillari (domen ishga tushguncha vaqtincha boshqa manzilga yo'naltirish uchun)
TELEGRAM_WEBHOOK_URL=""
META_WEBHOOK_URL=""
