// Uy-joy sayti ma'lumotlar bazasi sxemasi
// Hozircha SQLite (lokal). Postgres'ga o'tish uchun faqat
// prisma/schema.prisma dagi provider va .env dagi DATABASE_URL o'zgaradi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // owner | admin
  role         String    @default("admin")
  totpSecret   String
  totpEnabled  Boolean   @default(true)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  createdById  String?
  createdBy    AdminUser?  @relation("AdminCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers AdminUser[] @relation("AdminCreator")
}

model SaleOption {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameUz    String
  nameRu    String
  isActive  Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]

  @@index([isActive, sort])
}

model Listing {
  id            String      @id @default(cuid())
  slug          String      @unique
  // Eski maydon, endi ishlatilmaydi (barcha e'lonlar sotuv)
  type          String      @default("sale")
  saleOptionId  String?
  saleOption    SaleOption? @relation(fields: [saleOptionId], references: [id], onDelete: SetNull)
  // apartment | house | land | commercial
  propertyType  String      @default("apartment")
  titleUz       String
  titleRu       String
  descriptionUz String
  descriptionRu String
  price         BigInt
  // UZS | USD
  currency      String      @default("USD")
  rooms         Int?
  area          Int?
  floor         Int?
  totalFloors   Int?
  yearBuilt     Int?
  // yangi | tamirlangan | ortacha | ta'mirtalab
  condition     String?
  region        String
  district      String
  address       String
  lat           Float?
  lng           Float?
  phone         String
  // draft | active | sold
  status        String      @default("draft")
  views         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  photos Photo[]
  leads  Lead[]

  @@index([status, createdAt])
  @@index([type, propertyType])
  @@index([saleOptionId])
  @@index([district])
  @@index([price])
}

model Photo {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  alt       String   @default("")
  width     Int      @default(1200)
  height    Int      @default(800)
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId, sort])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleUz     String
  titleRu     String
  excerptUz   String
  excerptRu   String
  bodyUz      String
  bodyRu      String
  coverImage  String
  coverWidth  Int      @default(1200)
  coverHeight Int      @default(800)
  // bozor | qollanma | ipoteka | tahlil
  category    String   @default("qollanma")
  authorName  String
  authorRole  String   @default("")
  published   Boolean  @default(false)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

model VerifiedDevice {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  fingerprint String
  userAgent   String
  platform    String?
  language    String?
  timezone    String?
  screen      String?
  ip          String?
  isTrusted   Boolean  @default(false)
  visits      Int      @default(1)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([fingerprint])
  @@index([isTrusted, lastSeenAt])
}

model Lead {
  id        String   @id @default(cuid())
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  name      String
  phone     String
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Telegram orqali yozgan foydalanuvchi yoki kanal
model TelegramChat {
  id            String            @id @default(cuid())
  chatId        String            @unique
  title         String
  username      String?
  type          String            @default("private")
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  messages      TelegramMessage[]

  @@index([lastMessageAt])
}

/// Kelgan va yuborilgan Telegram xabarlari
model TelegramMessage {
  id          String       @id @default(cuid())
  chatRefId   String
  chat        TelegramChat @relation(fields: [chatRefId], references: [id], onDelete: Cascade)
  tgMessageId Int?
  direction   String
  text        String
  fromName    String?
  createdAt   DateTime     @default(now())

  @@unique([chatRefId, tgMessageId, direction])
  @@index([chatRefId, createdAt])
}

/// Meta (Facebook sahifa + Instagram) integratsiyasi sozlamalari — bitta qator
model MetaIntegration {
  id              String    @id @default("default")
  appId           String?
  appSecret       String?
  pageId          String?
  pageToken       String?
  igUserId        String?
  threadsUserId   String?
  threadsToken    String?
  threadsUsername String?
  pageName        String?
  igUsername      String?
  verifyToken     String
  connectedAt     DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Facebook Messenger yoki Instagram Direct suhbati
model MetaChat {
  id            String        @id @default(cuid())
  platform      String
  externalId    String
  name          String
  username      String?
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      MetaMessage[]

  @@unique([platform, externalId])
  @@index([lastMessageAt])
}

/// Meta orqali kelgan va yuborilgan xabarlar
model MetaMessage {
  id         String   @id @default(cuid())
  chatRefId  String
  chat       MetaChat @relation(fields: [chatRefId], references: [id], onDelete: Cascade)
  externalId String?
  direction  String
  text       String
  createdAt  DateTime @default(now())

  @@unique([chatRefId, externalId, direction])
  @@index([chatRefId, createdAt])
}
